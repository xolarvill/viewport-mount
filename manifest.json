{
  "manifest_version": 3,
  "name": "Viewport Mount - 响应式视口观察器",
  "version": "1.0.0",
  "description": "一键把页面切换到常见设备视口，并排对比各断点下的响应式布局。",
  "minimum_chrome_version": "100",
  "permissions": [
    "storage",
    "scripting",
    "webNavigation",
    "debugger",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Viewport Mount",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
